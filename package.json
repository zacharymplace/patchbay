{
  "name": "patchbay-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sim": "tsx scripts/sim.ts",
    "check": "tsc --noEmit",
    "verify": "npm run check && npm run sim && npm run sim:variants && npm run sim:player-plan && npm run build",
    "sim:variants": "tsx scripts/sim-variants.ts",
    "sim:player-plan": "tsx scripts/sim-player-plan.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "healthcheck": "bash scripts/healthcheck.sh",
    "bootstrap": "bash scripts/bootstrap.sh"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  }
}
